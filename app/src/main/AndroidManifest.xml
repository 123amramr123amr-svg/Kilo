<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access is required for talking to user-configured AI providers. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice input (speech recognition) only. Nothing is recorded in the background. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Task execution notifications (Android 13+ runtime permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      The agent's workspace is a folder the user picks with the system folder picker
      (Storage Access Framework). On Android 12L and older that picker refuses to hand
      out a tree without this legacy permission, so it is declared with maxSdkVersion
      and never requested on Android 13+. No broad storage access is used anywhere.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- The agent keeps working while you are in another app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      Android 11+ package visibility: the agent may list and open launchable apps
      when the user asks it to. Without these queries the launcher list is empty.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Speech recognition and TTS engines (Android 11+ package visibility). -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".PersonalAiAgentApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersonalAIAgent"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:configChanges="locale|layoutDirection|smallestScreenSize|screenSize|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PersonalAIAgent.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".platform.AgentRunService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
