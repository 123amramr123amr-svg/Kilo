    <!-- Privacy -->
    <string name="privacy_title">Privacy &amp; security</string>
    <string name="privacy_network_title">Where your data goes</string>
    <string name="privacy_network_body">Messages are sent only to the provider you configured, using the key you stored. There is no first-party server, no analytics SDK and no advertising SDK.</string>
    <string name="privacy_storage_title">Local storage</string>
    <string name="privacy_storage_body">Conversations, providers and task logs live in a local SQLite database. API keys are encrypted with AES-256-GCM using a non-exportable Android Keystore key.</string>
    <string name="privacy_backup_title">Backups</string>
    <string name="privacy_backup_body">Automatic cloud backup is disabled. Manual backups never include API keys.</string>
    <string name="privacy_logs_title">Logging</string>
    <string name="privacy_logs_body">Keys and message bodies are never written to logcat. HTTP body logging is disabled in release builds.</string>
