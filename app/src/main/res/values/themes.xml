<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all in-app styling; these themes only cover the window/splash. -->
    <style name="Theme.PersonalAIAgent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.PersonalAIAgent.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_app_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_navy</item>
        <item name="postSplashScreenTheme">@style/Theme.PersonalAIAgent</item>
    </style>
</resources>
